{% extends "base.html.j2" %}

{% block content %}
    <div class="container mt-5">
        <div class="row justify-content-center">
            <div class="col-md-8 col-lg-6">
                <div class="card p-4 p-md-5 text-center animate__animated animate__fadeIn">
                    
                    <h1 class="h3 mb-4 fw-bold text-secondary">{{ type|upper }} Gerado</h1>

                    <div class="bg-light p-4 rounded-3 border mb-4">
                        <h2 class="display-6 fw-bold text-dark mb-0" id="mensagem-gerada">{{ message }}</h2>
                    </div>

                    <div class="d-flex justify-content-center mb-4">
                        <div class="form-check form-switch">
                            <input class="form-check-input" type="checkbox" role="switch" id="pref-sem-pontuacao">
                            <label class="form-check-label small text-muted fw-bold" for="pref-sem-pontuacao">
                                COPIAR SEM PONTUAÇÃO
                            </label>
                        </div>
                    </div>

                    <div id="feedback" class="alert alert-success py-2 px-3 small mb-4 animate__animated animate__fadeIn" style="display:none;">
                        <i class="bi bi-check-circle-fill me-2"></i> Conteúdo copiado!
                    </div>

                    <div class="d-grid gap-2 d-md-flex justify-content-md-center">
                        <a href="/" class="btn btn-outline-secondary px-4">
                            <i class="bi bi-arrow-left"></i> Voltar
                        </a>
                        
                        <button type="button" class="btn btn-primary px-4" onclick="copiarMensagem()">
                            <i class="bi bi-clipboard"></i> Copiar
                        </button>

                        <form method="post" action="/gerador" class="m-0">
                            <input type="hidden" id="tipo" name="tipo" value="{{ type }}">
                            <button type="submit" class="btn btn-success px-4 w-100">
                                <i class="bi bi-arrow-clockwise"></i> Gerar Novo
                            </button>
                        </form>
                    </div>

                </div>
            </div>
        </div>
    </div>

    <script>
    const switchPref = document.getElementById('pref-sem-pontuacao');
    const feedback = document.getElementById('feedback');
    const valorGerado = document.getElementById('mensagem-gerada');

    document.addEventListener('DOMContentLoaded', () => {
        const savedPreference = localStorage.getItem('copyWithoutPunctuation') === 'true';
        switchPref.checked = savedPreference;
    });

    switchPref.addEventListener('change', () => {
        localStorage.setItem('copyWithoutPunctuation', switchPref.checked);
    });

    function copiarMensagem() {
        let texto = valorGerado.innerText;
        
        if (switchPref.checked) {
            texto = texto.replace(/[^a-zA-Z0-9]/g, '');
        }

        navigator.clipboard.writeText(texto).then(() => {
            feedback.innerHTML = switchPref.checked 
                ? '<i class="bi bi-check-circle-fill me-2"></i> Copiado sem pontuação!' 
                : '<i class="bi bi-check-circle-fill me-2"></i> Copiado com pontuação!';
                
            feedback.style.display = 'block';
            
            setTimeout(() => {
                feedback.style.display = 'none';
            }, 2000);
        }).catch(err => {
            console.error('Erro ao copiar: ', err);
        });
    }
    </script>
{% endblock %}